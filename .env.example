# ProblemFinderBackend — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- App ---
APP_NAME=Immensity API
ENVIRONMENT=development
DEBUG=false

# --- Database (Supabase / Postgres) ---
# Async driver URL, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/problemfinder

# --- Firebase (auth + Firestore) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account-prod.json

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_YEARLY_PRICE_ID=price_...
APP_URL=http://localhost:3000

# --- OpenAI (search embeddings) ---
OPENAI_API_KEY=sk-...

# --- Anthropic (recommended next step / opportunity briefs) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- CORS (comma-separated allowlist of frontend origins) ---
ALLOWED_ORIGINS=http://localhost:3000
