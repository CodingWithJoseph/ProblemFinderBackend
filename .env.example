# ProblemFinderBackend environment variables

APP_NAME=Immensity API
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/problemfinder

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account-prod.json

OPENAI_API_KEY=sk-...

# Conversational search interpreter. Railway can use provider=groq,
# base URL=https://api.groq.com/openai/v1 and model=openai/gpt-oss-20b.
SEARCH_INTERPRETER_PROVIDER=local
SEARCH_INTERPRETER_BASE_URL=http://127.0.0.1:8080/v1
SEARCH_INTERPRETER_MODEL=gpt-oss-20b
SEARCH_INTERPRETER_TIMEOUT_SECONDS=30
GROQ_API_KEY=

# Problem Breakdown analysis inherits the search provider values when these are blank.
SIGNAL_ANALYSIS_PROVIDER=
SIGNAL_ANALYSIS_BASE_URL=
SIGNAL_ANALYSIS_MODEL=
SIGNAL_ANALYSIS_TIMEOUT_SECONDS=90
SIGNAL_ANALYSIS_MAX_EVIDENCE=30
SIGNAL_ANALYSIS_MIN_EVIDENCE=3
SIGNAL_ANALYSIS_WORKER_ENABLED=true
SIGNAL_ANALYSIS_POLL_SECONDS=2

# Build drafting is configured separately so Analyze and Build can use different
# models. Ollama is the temporary default and uses its OpenAI-compatible API.
# Set provider=openai and model=gpt-5.6-terra when hosted generation is enabled.
# provider=local remains available for llama.cpp-compatible servers.
SOLUTION_PROVIDER=ollama
SOLUTION_BASE_URL=http://127.0.0.1:11434/v1
SOLUTION_MODEL=gpt-oss:20b
SOLUTION_TIMEOUT_SECONDS=120
SOLUTION_REASONING_EFFORT=medium
SOLUTION_MAX_OUTPUT_TOKENS=10000
SOLUTION_WORKER_ENABLED=true

# Comma-separated. Production: https://console.useimmensity.com
ALLOWED_ORIGINS=http://localhost:3000
