# ProblemFinderBackend — environment variables
# Copy to `.env` and fill in. Never commit the real `.env`.

# --- App ---
APP_NAME=Immensity API
ENVIRONMENT=development
DEBUG=false

# --- Database (Supabase / Postgres) ---
# Async driver URL, e.g. postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/problemfinder

# --- Firebase (auth + Firestore) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account-prod.json

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_...
STRIPE_ELITE_YEARLY_PRICE_ID=price_...
APP_URL=http://localhost:3000

# --- OpenAI (search embeddings) ---
OPENAI_API_KEY=sk-...

# --- Anthropic (recommended next step / opportunity briefs) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email ---
# Transport: "console" (default; logs the message, no creds needed) or "resend".
EMAIL_TRANSPORT=console
EMAIL_FROM=invites@useimmensity.com
# Only used when EMAIL_TRANSPORT=resend:
RESEND_API_KEY=
# Hours a team invite link stays valid (default 7 days).
INVITE_TOKEN_TTL_HOURS=168

# --- Revenue auto-sync ---
# How often to re-pull connected Stripe revenue sources, in hours (0 disables).
REVENUE_SYNC_INTERVAL_HOURS=6

# --- Alerting ---
# Scheduled checks email the product owner. Real mail only sends when
# EMAIL_TRANSPORT=resend; otherwise the console transport logs it.
ALERTS_ENABLED=true
ALERT_CHECK_INTERVAL_HOURS=1

# --- CORS (comma-separated allowlist of frontend origins) ---
ALLOWED_ORIGINS=http://localhost:3000
