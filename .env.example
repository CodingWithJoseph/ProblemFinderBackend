# ProblemFinderBackend environment variables

APP_NAME=Immensity API
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/problemfinder

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=firebase-service-account-prod.json

# One model source powers Search, Analyze, Analyze conversations, and Build.
# Development uses a local OpenAI-compatible llama.cpp server.
# Production must use the official OpenAI endpoint.
AI_PROVIDER=local
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=gpt-oss-20b
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_REASONING_EFFORT=medium

# Analyze workflow limits. These do not select a separate model.
SIGNAL_ANALYSIS_MAX_EVIDENCE=30
SIGNAL_ANALYSIS_MIN_EVIDENCE=3
SIGNAL_ANALYSIS_WORKER_ENABLED=true
SIGNAL_ANALYSIS_POLL_SECONDS=2

# Build workflow limits. Build uses the same gateway and model above.
SOLUTION_MAX_OUTPUT_TOKENS=10000
SOLUTION_WORKER_ENABLED=true

# Comma-separated. Production: https://console.useimmensity.com
ALLOWED_ORIGINS=http://localhost:3000
